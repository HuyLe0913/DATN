# API Keys (OpenRouter & Mistral)
OPENROUTER_API_KEY=your_openrouter_key_here
MISTRAL_API_KEY=your_mistral_key_here

# LLM Models
# Model used for extracting entities and relations into the knowledge graph
GRAPH_EXTRACTOR_MODEL=qwen/qwen3.6-plus:free
# Model used for the agentic orchestration and tool calling
AGENT_MODEL_NAME=openrouter/google/gemini-2.5-flash-lite

# Data Directories
INPUT_DIR=./data/raw
OUTPUT_DIR=./data/processed

# Processing Configuration
DELAY_SECONDS=4
MAX_WORKERS=5
CHUNK_SIZE=5

# Database Configuration (PostgreSQL)
POSTGRES_URL=postgresql://user:password@postgres-db:5432/ews_rag

# Vector Database (Weaviate)
WEAVIATE_URL=http://weaviate:8080

# Task Queue (Redis)
CELERY_BROKER_URL=redis://redis:6379/0

# Knowledge Graph (Neo4j)
NEO4J_URL=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Embedding Model
EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# S3/Object Storage (MinIO)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# MCP (Model Context Protocol) Configuration
BACKEND_API_URL=http://app:8000
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8000
